            "type": "string"
          },
          "query": {
            "description": "SuiteQL SELECT query, e.g. \"SELECT id, companyName FROM customer\". Read-only.",
            "title": "Query",
            "type": "string"
          },
          "limit": {
            "default": 100,
            "description": "Max rows to return (1-1000).",
            "maximum": 1000,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          },
          "offset": {
            "default": 0,
