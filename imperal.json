    {
      "name": "run_suiteql",
      "description": "Run a SuiteQL SELECT query against NetSuite (query/v1/suiteql) -- the most powerful read path: joins, filters, aggregates. Read-only; writes go through create_record/update_record. Limit 1-1000 rows.",
      "action_type": "write",
      "chain_callable": true,
      "effects": [],
      "id_projection": "",
      "params_schema": {
        "properties": {
          "connection_id": {
            "default": "",
            "description": "Saved connection id; empty uses the most recent connection.",
