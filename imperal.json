          "record_type": {
            "description": "NetSuite record type, e.g. 'customer', 'salesorder', 'invoice', 'item', 'vendor'.",
            "title": "Record Type",
            "type": "string"
          },
          "limit": {
            "default": 50,
            "description": "Max records to return (1-1000).",
            "maximum": 1000,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          },
          "offset": {
            "default": 0,
            "description": "Skip this many records (pagination).",
            "minimum": 0,
            "title": "Offset",
            "type": "integer"
          }
        },
        "required": [
          "record_type"
        ],
        "title": "ListRecordsParams",
        "type": "object"
